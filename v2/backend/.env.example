# v2.0 Backend — environment configuration
# Copy to .env and adjust for your machine.

# Path to the SQLite file. Created on first startup if missing.
# Must be inside v2/backend/data/ (created automatically on startup).
DB_PATH=./data/jd_builder.db

# Path to the project root (for validation — DB_PATH must be inside this).
PROJECT_ROOT=../..

# NOC pipeline — point at the v1.0 NOC database (app.db).
# app.db is the 83 MB v1.0 SQLite file with noc_units, noc_elements, noc_fts,
# noc_chunks_vec (FLOAT[768] vec0 cosine). It is READ-ONLY from v2's perspective.
NOC_DB_PATH=/home/charles/job_description_builder/app.db

# Ollama (local LLM + embed) — used by the NOC pipeline Stage 2 + Stage 3.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=gemma4:31b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Optional: set CLOUD_API_KEY to route Stage 3 LLM justification to MiniMax
# instead of Ollama. If unset, generation uses OLLAMA_GENERATION_MODEL.
# CLOUD_API_KEY=your-key-here
# CLOUD_MODEL=MiniMax-M3
# CLOUD_BASE_URL=https://api.minimax.io/v1
