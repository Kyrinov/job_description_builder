# Ollama configuration
# Must be localhost — never point to an external host (security: T-1-02)
OLLAMA_BASE_URL=http://localhost:11434

# Use the dense base generation model — do NOT use role variants or planner/implementer agent models
# Run: ollama list   to confirm this model is present before starting the app
OLLAMA_GENERATION_MODEL=gemma4:31b

# Required for NOC semantic search (Phase 2+); confirm with: ollama list
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Absolute path to the SQLite database file
# Must be under the project directory — path traversal is not permitted (security: T-1-01)
DB_PATH=/home/charles/job_description_builder/app.db

# Absolute path to the data/ directory containing NOC, CA, JES, DRF source files
DATA_DIR=/home/charles/job_description_builder/data

# MiniMax API (optional) — when set, Stage 3 (LLM ranking/justification) uses MiniMax
# instead of the local Ollama generation model. Stage 2 (embedding) always uses Ollama.
# MINIMAX_API_KEY=your-key-here
# MINIMAX_MODEL=minimax-m3
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
